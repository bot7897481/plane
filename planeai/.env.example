# ─────────────────────────────────────────────
# PlaneAI Agent Service — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Plane Connection ──────────────────────────
# Your Plane instance URL (local or hosted)
PLANE_BASE_URL=http://localhost:8000
# API token from Plane Settings → API Tokens
PLANE_API_TOKEN=your_plane_api_token_here
# Your workspace slug (visible in Plane URL: /your-workspace/...)
PLANE_WORKSPACE_SLUG=your-workspace

# ── Anthropic (Claude) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model for planning and code implementation (powerful)
ANTHROPIC_IMPLEMENTATION_MODEL=claude-opus-4-6
# Model for quick decisions, summaries (fast + cheap)
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# ── PlaneAI Service ──────────────────────────
PLANEAI_HOST=0.0.0.0
PLANEAI_PORT=9000
# How often (seconds) to poll Plane for new tasks
PLANEAI_POLL_INTERVAL=30
# "AI Agent" user ID in Plane — tasks assigned to this user are picked up
PLANEAI_AGENT_USER_ID=your_plane_agent_user_id
# Secret key for dashboard auth
PLANEAI_SECRET_KEY=change-me-in-production

# ── Redis (same instance as Parseek) ─────────
REDIS_URL=redis://localhost:6379/1

# ── Workspace Paths ──────────────────────────
# Root directory where your coding projects live
PROJECTS_ROOT=/Users/you/projects
# Specific project paths (comma-separated name:path pairs)
# PlaneAI maps Plane projects to local directories by project name
# Example: parseek:/Users/you/projects/parseek,vazier:/Users/you/projects/vazier-ai
PROJECT_PATHS=parseek:/path/to/parseek,vazier:/path/to/vazier-ai

# ── Safety ───────────────────────────────────
# Max lines Claude can write per task before stopping for review
MAX_LINES_PER_TASK=500
# Max shell command timeout (seconds)
SHELL_TIMEOUT=120
# Whether to require human approval before committing code
REQUIRE_APPROVAL=false
# Git branch prefix for AI-generated branches
AI_BRANCH_PREFIX=planeai/
